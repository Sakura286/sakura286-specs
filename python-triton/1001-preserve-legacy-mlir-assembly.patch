From: peterbell10 <peterbell10@openai.com>
Subject: [PATCH] Preserve legacy assembly for Triton dialects

Backport the dialect settings from 1e259627c3426df5372396ba0640b76f3deb6402
("[LLVM] Update LLVM to 18f9e623 (#12236)").

--- a/include/triton/Dialect/Triton/IR/TritonDialect.td
+++ b/include/triton/Dialect/Triton/IR/TritonDialect.td
@@ -8,6 +8,9 @@ def Triton_Dialect : Dialect {

   let cppNamespace = "::mlir::triton";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
+
   let summary = "The Triton IR in MLIR";

   let description = [{
--- a/include/triton/Dialect/TritonGPU/IR/TritonGPUDialect.td
+++ b/include/triton/Dialect/TritonGPU/IR/TritonGPUDialect.td
@@ -8,6 +8,9 @@ def TritonGPU_Dialect : Dialect {

   let cppNamespace = "::mlir::triton::gpu";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
+
   let hasOperationAttrVerify = 1;

   let description = [{
--- a/include/triton/Dialect/TritonInstrument/IR/TritonInstrumentDialect.td
+++ b/include/triton/Dialect/TritonInstrument/IR/TritonInstrumentDialect.td
@@ -6,6 +6,9 @@ include "mlir/IR/OpBase.td"
 def TritonInstrument_Dialect : Dialect {
   let name = "tti";
   let cppNamespace = "::mlir::triton::instrument";
+
+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
 }

 #endif // TRITONINSTRUMENT_DIALECT
--- a/include/triton/Dialect/TritonNvidiaGPU/IR/TritonNvidiaGPUDialect.td
+++ b/include/triton/Dialect/TritonNvidiaGPU/IR/TritonNvidiaGPUDialect.td
@@ -29,6 +29,9 @@ def TritonNvidiaGPU_Dialect : Dialect {

   let cppNamespace = "::mlir::triton::nvidia_gpu";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
+
   let hasOperationAttrVerify = 1;
   let hasCanonicalizer = 1;

--- a/third_party/amd/include/Dialect/TritonAMDGPU/IR/TritonAMDGPUDialect.td
+++ b/third_party/amd/include/Dialect/TritonAMDGPU/IR/TritonAMDGPUDialect.td
@@ -30,6 +30,9 @@ def TritonAMDGPU_Dialect : Dialect {
   let name = "amdg";
   let cppNamespace = "::mlir::triton::amdgpu";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
