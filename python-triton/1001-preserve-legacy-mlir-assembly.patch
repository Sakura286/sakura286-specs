--- a/third_party/proton/Dialect/include/Dialect/ProtonGPU/IR/ProtonGPUDialect.td
+++ b/third_party/proton/Dialect/include/Dialect/ProtonGPU/IR/ProtonGPUDialect.td
@@ -7,6 +7,9 @@ def ProtonGPU_Dialect : Dialect {
   let name = "proton_gpu";
   let cppNamespace = "::mlir::triton::proton::gpu";

+  // Preserve the existing attr-dict syntax for inherent attributes.
