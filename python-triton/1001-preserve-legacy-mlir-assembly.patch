   let description = [{
     TritonAMDGPU Dialect hosts AMD specific ops at TritonGPU abstraction level.
   }];
--- a/third_party/nvidia/include/Dialect/NVGPU/IR/NVGPUDialect.td
+++ b/third_party/nvidia/include/Dialect/NVGPU/IR/NVGPUDialect.td
@@ -28,6 +28,9 @@ def NVGPU_Dialect : Dialect {
   let name = "nvg";
   let cppNamespace = "::mlir::triton::nvgpu";

+  // Preserve the existing attr-dict syntax for inherent attributes.
+  let useStrictPropertiesInAssemblyFormat = 0;
+
   let description = [{
     NVGPU Dialect.
   }];
--- a/third_party/nvidia/include/Dialect/NVWS/IR/NVWSDialect.td
+++ b/third_party/nvidia/include/Dialect/NVWS/IR/NVWSDialect.td
@@ -28,6 +28,9 @@ def NVWS_Dialect : Dialect {
   let name = "nvws";
   let cppNamespace = "::mlir::triton::nvws";

+  // Preserve the existing attr-dict syntax for inherent attributes.
