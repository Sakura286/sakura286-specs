From: CHEN Xuan <chenxuan@iscas.ac.cn>
Subject: [PATCH] Build AMD and external backends without the NVIDIA plugin

Downstream openRuyi adaptation for the triton-riscv 3.9.0 snapshot baseline.
Keep NVIDIA Python layout/descriptor modules: common native Gluon code
imports them even when the NVIDIA runtime backend is disabled.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,12 +23,18 @@
 option(TRITON_BUILD_NVIDIA_GSAN_RUNTIME
        "Build the CUDA/NVPTX GSan device runtime for the NVIDIA backend" ON)
 option(TRITON_STABLE_ABI "Build with Python Stable ABI (abi3) for Python 3.12+" OFF)
+option(TRITON_BUILD_TOOLS "Build Triton command-line tools and tests" ON)
 option(TRITON_BUILD_UT "Build C++ Triton Unit Tests" ON)
 option(TRITON_BUILD_WITH_CCACHE "Build with ccache (if available)" ON)
 option(TRITON_OFFLINE_BUILD "Build without downloading dependencies" OFF)
 option(TRITON_EXT_ENABLED "Build with default visibility for Triton+LLVM symbol exposure to plugin extensions" OFF)
 set(TRITON_CODEGEN_BACKENDS "" CACHE STRING "Enable different codegen backends")
 set(TRITON_VERSION "" CACHE STRING "Triton version string (passed from setup.py)")
+
+set(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN OFF)
+if("nvidia" IN_LIST TRITON_CODEGEN_BACKENDS)
+  set(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN ON)
+endif()

 set(TRITON_CACHE_PATH "" CACHE PATH "Path to triton cache")
 set(TRITON_LLVM_SYSTEM_SUFFIX "" CACHE STRING "Path to LLVM system suffix")
@@ -351,11 +357,15 @@
     add_subdirectory(third_party/${CODEGEN_BACKEND})
   endforeach()

+  # Common Gluon and AMD lowering still depend on NVIDIA dialect definitions.
+  if(NOT TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+    add_subdirectory(third_party/nvidia)
+  endif()
   if (TRITON_BUILD_PROTON)
     add_subdirectory(third_party/proton)
+    list(APPEND TRITON_PLUGIN_NAMES "proton")
   endif()
   # We always build proton dialect
-  list(APPEND TRITON_PLUGIN_NAMES "proton")
   add_subdirectory(third_party/proton/Dialect)

   if (DEFINED TRITON_PLUGIN_DIRS)
@@ -533,8 +543,10 @@
 find_package(Threads REQUIRED)

 add_subdirectory(third_party/f2reduce)
-add_subdirectory(bin)
-add_subdirectory(test)
+if(TRITON_BUILD_TOOLS)
+  add_subdirectory(bin)
+  add_subdirectory(test)
+endif()

 if(TRITON_BUILD_UT)
   add_subdirectory(unittest)
--- a/setup.py
+++ b/setup.py
@@ -397,7 +397,7 @@
                                   cwd=cmake_dir)

 
-backends = [*BackendInstaller.copy(["nvidia", "amd"]), *BackendInstaller.copy_externals()]
+backends = [*BackendInstaller.copy(os.getenv("TRITON_CODEGEN_BACKENDS", "nvidia;amd").split(";")), *BackendInstaller.copy_externals()]

 
 def get_package_dirs():
@@ -428,7 +428,11 @@

 
 def get_packages():
-    yield from find_packages(where="python")
+    excludes = []
+    if not any(b.name == "nvidia" for b in backends):
+        excludes = ["triton.tools.triton_to_gluon_translater",
+                    "triton.tools.triton_to_gluon_translater.*"]
+    yield from find_packages(where="python", exclude=excludes)

     for backend in backends:
         yield f"triton.backends.{backend.name}"
@@ -544,6 +548,9 @@
             "proton-viewer = triton.profiler.viewer:main",
             "proton = triton.profiler.proton:main",
         ]
+    if any(b.name == "triton_shared" for b in backends):
+        entry_points.setdefault("console_scripts", []).append(
+            "triton-shared-opt = triton.backends.triton_shared.cli:main")
     entry_points["triton.backends"] = [f"{b.name} = triton.backends.{b.name}" for b in backends]
     return entry_points

--- a/lib/Conversion/CMakeLists.txt
+++ b/lib/Conversion/CMakeLists.txt
@@ -1,3 +1,5 @@
 add_subdirectory(TritonToTritonGPU)
 add_subdirectory(TritonGPUToLLVM)
-add_subdirectory(TritonInstrumentToLLVM)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(TritonInstrumentToLLVM)
+endif()
--- a/third_party/nvidia/CMakeLists.txt
+++ b/third_party/nvidia/CMakeLists.txt
@@ -2,7 +2,7 @@
 include_directories(${CMAKE_CURRENT_BINARY_DIR}/include)
 add_subdirectory(include)
 add_subdirectory(lib)
-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
   if(TRITON_BUILD_NVIDIA_GSAN_RUNTIME)
     set(GSAN_RUNTIME_DIR "${triton_SOURCE_DIR}/python/triton/experimental/gsan/src")
     set(GSAN_RUNTIME_HDRS
@@ -61,7 +61,7 @@
     add_dependencies(TritonNVIDIA TritonNVIDIAGSanRuntime)
   endif()
 endif()
-if(TRITON_BUILD_UT)
+if(TRITON_BUILD_UT AND TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
   add_subdirectory(unittest)
 endif()
 add_subdirectory(hopper)
--- a/third_party/nvidia/hopper/CMakeLists.txt
+++ b/third_party/nvidia/hopper/CMakeLists.txt
@@ -1,2 +1,4 @@
 add_subdirectory(include)
-add_subdirectory(lib)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(lib)
+endif()
--- a/third_party/proton/Dialect/CMakeLists.txt
+++ b/third_party/proton/Dialect/CMakeLists.txt
@@ -2,7 +2,7 @@
 include_directories(${CMAKE_CURRENT_BINARY_DIR}/include)
 add_subdirectory(include)
 add_subdirectory(lib)
-if(TRITON_BUILD_PYTHON_MODULE)
+if(TRITON_BUILD_PYTHON_MODULE AND TRITON_BUILD_PROTON)
   add_triton_plugin(TritonProton ${CMAKE_CURRENT_SOURCE_DIR}/triton_proton.cc LINK_LIBS ProtonToProtonGPU ProtonGPUToLLVM ProtonAMDGPUToLLVM ProtonNVIDIAGPUToLLVM ProtonAnalysis)
   target_link_libraries(TritonProton PRIVATE Python3::Module nanobind-static)
 endif()
--- a/third_party/nvidia/include/CMakeLists.txt
+++ b/third_party/nvidia/include/CMakeLists.txt
@@ -1,3 +1,5 @@
 add_subdirectory(Dialect)
-add_subdirectory(TritonNVIDIAGPUToLLVM)
-add_subdirectory(NVGPUToLLVM)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(TritonNVIDIAGPUToLLVM)
+  add_subdirectory(NVGPUToLLVM)
+endif()
--- a/third_party/nvidia/lib/CMakeLists.txt
+++ b/third_party/nvidia/lib/CMakeLists.txt
@@ -1,3 +1,5 @@
 add_subdirectory(Dialect)
-add_subdirectory(TritonNVIDIAGPUToLLVM)
-add_subdirectory(NVGPUToLLVM)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(TritonNVIDIAGPUToLLVM)
+  add_subdirectory(NVGPUToLLVM)
+endif()
--- a/third_party/proton/Dialect/include/Conversion/ProtonGPUToLLVM/CMakeLists.txt
+++ b/third_party/proton/Dialect/include/Conversion/ProtonGPUToLLVM/CMakeLists.txt
@@ -2,5 +2,7 @@
 mlir_tablegen(Passes.h.inc -gen-pass-decls --name ProtonGPUToLLVM)
 add_public_tablegen_target(ProtonGPUConversionPassIncGen)

-add_subdirectory(ProtonNvidiaGPUToLLVM)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(ProtonNvidiaGPUToLLVM)
+endif()
 add_subdirectory(ProtonAMDGPUToLLVM)
--- a/third_party/proton/Dialect/lib/ProtonGPUToLLVM/CMakeLists.txt
+++ b/third_party/proton/Dialect/lib/ProtonGPUToLLVM/CMakeLists.txt
@@ -12,5 +12,7 @@
     ProtonAnalysis
 )

-add_subdirectory(ProtonNvidiaGPUToLLVM)
+if(TRITON_BUILD_NVIDIA_BACKEND_PLUGIN)
+  add_subdirectory(ProtonNvidiaGPUToLLVM)
+endif()
 add_subdirectory(ProtonAMDGPUToLLVM)
